class RushHourGame {
    field Board board;
    field boolean exit;
    field int selectedCar;
    field int seed;
    field int moves;
    field boolean won;
    field String sMoves;
    field String sMenu;
    field String sWin;

    /** Constructs a new Rush Hour Game. */
    constructor RushHourGame new(int aseed) {
        let seed = aseed;
        let moves = 0;
        let won = false;
        
        let sMoves = "Moves: ";
        let sMenu = "[R] Regen  [Q] Quit";
        let sWin = "You Win! Press R";
        
        let board = Board.new();
        
        // Generate level based on seed
        do LevelGenerator.generate(board, seed);
        
        let selectedCar = 0;
        
        do board.draw();
        do board.drawCar(selectedCar, true); // Highlight selected
        do drawDashboard();
        
        let exit = false;
        return this;
    }

    /** Runs the game: handles the user's inputs and moves the square accordingly */
    method void run() {
        var char key;
        var boolean redraw;
        var boolean moved;
        var Car redCar; // Declare outside loop if possible or inside block
        
        while (~exit) {
            // waits for a key to be pressed
            while (key = 0) {
                let key = Keyboard.keyPressed();
            }
            
            let redraw = false;
            let moved = false;

            if (key = 81)  { let exit = true; }     // q
            
            // R key for Reset (82 or 114)
            if (key = 82) {
                let seed = seed + 1;
                let moves = 0;
                let won = false;
                do board.dispose();
                do Screen.clearScreen();
                let board = Board.new();
                do LevelGenerator.generate(board, seed);
                let selectedCar = 0;
                do board.draw();
                do board.drawCar(selectedCar, true);
                do drawDashboard();
                do Sys.wait(500); // Prevent spamming
            }
            
            if (~won) {
                // Selection: 0-9 (key 48-57). '0' maps to index 0.
                if ((key > 47) & (key < 58)) {
                    // Deselect old
                    do board.drawCar(selectedCar, false);
                    let selectedCar = key - 48;
                    // Check bounds (optional, if we have fewer cars)
                    if (selectedCar > (board.getCarCount() - 1)) {
                         let selectedCar = board.getCarCount() - 1;
                    }
                    // Select new
                    do board.drawCar(selectedCar, true);
                }
                
                // Movement: Arrows
                // Up: 131, Down: 133, Left: 130, Right: 132
                
                if (key = 131) { 
                    let moved = board.moveCar(selectedCar, 1); 
                    let redraw = true; 
                } 
                if (key = 133) { 
                    let moved = board.moveCar(selectedCar, 2); 
                    let redraw = true; 
                }
                if (key = 130) { 
                    let moved = board.moveCar(selectedCar, 3); 
                    let redraw = true; 
                }
                if (key = 132) { 
                    let moved = board.moveCar(selectedCar, 4); 
                    let redraw = true; 
                }
            }

            if (redraw) {
                // If move was successful, increment moves
                if (moved) {
                    let moves = moves + 1;
                    do drawDashboard();
                }

                // Call board.draw() again updates grid visuals
                do board.draw(); 
                do board.drawCar(selectedCar, true);
                
                // Win Check: Car 0 (Red) reached x=4 (occupies 4,5)
                let redCar = board.getCar(0);
                if (redCar.getX() = 4) {
                    do Output.moveCursor(11, 23);
                    do Output.printString(sWin);
                    let won = true;
                }
            }

            // waits for the key to be released
            while (~(key = 0)) {
                let key = Keyboard.keyPressed();
            }
        }
        return;
    }
    
    /** Draws the dashboard below the board. */
    method void drawDashboard() {
        // Board is 160,32 to 160+192,32+192 (Right=352, Bottom=224).
        // Screen Height 256. Bottom area: 224 to 256.
        
        // Moves: Left aligned? Or Centered?
        // Let's put instructions below the board. 
        // Board left X = 160.
        
        do Output.moveCursor(21, 20); // Row 21 is approx Y=231
        do Output.printString(sMoves);
        do Output.printInt(moves);
        
        do Output.moveCursor(22, 20);
        do Output.printString(sMenu);
        return;
    }

    /** Disposes this game. */
    method void dispose() {
        if (~(sMoves = 0)) { do sMoves.dispose(); }
        if (~(sMenu = 0)) { do sMenu.dispose(); }
        if (~(sWin = 0)) { do sWin.dispose(); }
        do board.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
