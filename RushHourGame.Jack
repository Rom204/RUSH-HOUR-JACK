class RushHourGame {
    field Board board;
    field boolean exit;
    field int selectedCar;

    /** Constructs a new Rush Hour Game. */
    constructor RushHourGame new(int seed) {
        let board = Board.new();
        
        // Generate level based on seed
        do LevelGenerator.generate(board, seed);
        
        let selectedCar = 0;
        
        do board.draw();
        do board.drawCar(selectedCar, true); // Highlight selected
        
        let exit = false;
        return this;
    }

    /** Runs the game: handles the user's inputs and moves the square accordingly */
    method void run() {
        var char key;
        var boolean redraw;
        var Car redCar;
        
        while (~exit) {
            // waits for a key to be pressed
            while (key = 0) {
                let key = Keyboard.keyPressed();
            }
            
            let redraw = false;

            if (key = 81)  { let exit = true; }     // q
            
            // Selection: 0-9 (key 48-57). '0' maps to index 0.
            if ((key > 47) & (key < 58)) {
                // Deselect old
                do board.drawCar(selectedCar, false);
                let selectedCar = key - 48;
                // Check bounds (optional, if we have fewer cars)
                if (selectedCar > (board.getCarCount() - 1)) {
                     let selectedCar = board.getCarCount() - 1;
                }
                // Select new
                do board.drawCar(selectedCar, true);
            }
            
            // Movement: Arrows
            // Up: 131, Down: 133, Left: 130, Right: 132
            
            if (key = 131) { do board.moveCar(selectedCar, 1); let redraw = true; } // Up
            if (key = 133) { do board.moveCar(selectedCar, 2); let redraw = true; } // Down
            if (key = 130) { do board.moveCar(selectedCar, 3); let redraw = true; } // Left
            if (key = 132) { do board.moveCar(selectedCar, 4); let redraw = true; } // Right

            if (redraw) {
                // Clear grid area before redraw to avoid trails? 
                // Or Board.moveCar handles clean redraw? 
                // Board.moveCar only updates grid. We should ideally clear and redraw active active areas.
                // For simplicity, let's redraw entire board or just the car.
                // Since moveCar updates internal state, let's simple redraw the specific car?
                // Problem: If it moves, we need to clear its old spot.
                // Helper: board.draw() clears lines but not rectangles?
                // Let's force full redraw for robustness first.
                
                // Optimization: Erase old car pos? Board.moveCar does logic but not drawing.
                // Actually, Board.moveCar logic I wrote implies it updates grid.
                // Let's just call board.draw() again.
                do board.draw(); 
                do board.drawCar(selectedCar, true);
                
                // Win Check: Car 0 (Red) reached x=4 (occupies 4,5)
                let redCar = board.getCar(0);
                if (redCar.getX() = 4) {
                    do Output.moveCursor(11, 27);
                    do Output.printString("You Win!");
                    do Sys.wait(2000); // Wait 2 seconds
                    let exit = true;
                }
                // Re-select loop var to avoid double object access if needed, but here it's fine.
            }

            // waits for the key to be released
            while (~(key = 0)) {
                let key = Keyboard.keyPressed();
            }
        }
        return;
    }

    /** Disposes this game. */
    method void dispose() {
        do board.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
