class Board {
    field Array grid;

    /** Constructs a new Board. */
    constructor Board new() {
        let grid = Array.new(36);
        do clear();
        return this;
    }

    /** Clears the board. */
    method void clear() {
        var int i;
        let i = 0;
        while (i < 36) {
            let grid[i] = 0;
            let i = i + 1;
        }
        return;
    }

    /** Returns the value at (x, y). Returns -1 if out of bounds. */
    method int get(int x, int y) {
        if ((x < 0) | (x > 5) | (y < 0) | (y > 5)) {
            return -1;
        }
        return grid[(y * 6) + x];
    }

    /** Sets the value at (x, y). Returns true if successful. */
    method boolean set(int x, int y, int value) {
        if ((x < 0) | (x > 5) | (y < 0) | (y > 5)) {
            return false;
        }
        let grid[(y * 6) + x] = value;
        return true;
    }

    /** Checks if a cell is free (value 0). */
    method boolean isFree(int x, int y) {
        if (get(x, y) = 0) {
            return true;
        }
        return false;
    }

    /** Disposes the board. */
    method void dispose() {
        do grid.dispose();
        do Memory.deAlloc(this);
        return;
    }
}