class Main {
    function void main() {
        var RushHourGame game;
        var int seed;
        var char key;
        
        do Output.moveCursor(8, 26);
        do Output.printString("RUSH HOUR");
        
        do Output.moveCursor(10, 23);
        do Output.printString("The Logic Game");
        
        do Output.moveCursor(14, 26);
        do Output.printString("CONTROLS:");
        
        do Output.moveCursor(16, 17);
        do Output.printString("Press keys 0-5 to select cars");
        
        do Output.moveCursor(18, 18);
        do Output.printString("Use Arrow Key to move them");
        
        do Output.moveCursor(20, 20);
        do Output.printString("Press any key to start...");
        
        let seed = 0;
        let key = 0;
        
        while (key = 0) {
            let key = Keyboard.keyPressed();
            let seed = seed + 1;
        }
        
        // Clear previous output
        do Screen.clearScreen();
        
        let game = RushHourGame.new(seed);
        do game.run();
        do game.dispose();
        return;
    }
}
