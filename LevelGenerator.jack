class LevelGenerator {
    
    /** Generates a level based on the seed. */
    function void generate(Board board, int seed) {
        var int layout;
        // Modulo 4 for 4 levels
        let layout = seed - ((seed / 4) * 4); // seed % 4
        
        if (layout = 0) { do LevelGenerator.level1(board); }
        if (layout = 1) { do LevelGenerator.level2(board); }
        if (layout = 2) { do LevelGenerator.level3(board); }
        if (layout = 3) { do LevelGenerator.level4(board); }
        return;
    }

    /** Level 1: "First Steps" (Easy) */
    function void level1(Board board) {
        // Player (0): (0,2) Length 2
        do board.addCar(0, 2, 2, false, true, 0); // (0,2), (1,2)
        
        // Car 1 (V): (2,1) Length 2 - The only real blocker
        do board.addCar(2, 1, 2, true, false, 1); // (2,1), (2,2)
        
        // Car 2 (H): (3,3) Length 2 - Support/Distraction
        do board.addCar(3, 3, 2, false, false, 2); // (3,3), (4,3)
        
        // Car 3 (H): (0,0) Length 2 - Noise
        do board.addCar(0, 0, 2, false, false, 3); // (0,0), (1,0)
        
        // Car 4 (V): (5,0) Length 2 - Extra Noise
        do board.addCar(5, 0, 2, true, false, 4); // (5,0), (5,1)
        
        // Car 5 (H): (0,4) Length 2
        do board.addCar(0, 4, 2, false, false, 5); // (0,4), (1,4)
        return;
    }

    /** Level 2: "The Gatekeeper" */
    function void level2(Board board) {
        // Player (0): (0,2) Length 2
        do board.addCar(0, 2, 2, false, true, 0); // (0,2), (1,2)
        
        // Car 1 (V): (3,1) Length 3 - The big wall
        do board.addCar(3, 1, 3, true, false, 1); // (3,1), (3,2), (3,3)
        
        // Car 2 (H): (0,4) Length 2
        do board.addCar(0, 4, 2, false, false, 2); // (0,4), (1,4)
        
        // Car 3 (V): (5,0) Length 2
        do board.addCar(5, 0, 2, true, false, 3); // (5,0), (5,1)
        
        // Car 4 (H): (2,0) Length 2 - Extra
        do board.addCar(2, 0, 2, false, false, 4); // (2,0), (3,0)
        
        // Car 5 (H): (4,4) Length 2
        do board.addCar(4, 4, 2, false, false, 5); // (4,4), (5,4)
        return;
    }

    /** Level 3: "The Slice" */
    function void level3(Board board) {
        // Player (0): (0,2) Length 2
        do board.addCar(0, 2, 2, false, true, 0); // (0,2), (1,2)
        
        // Car 1 (V): (2,1) Length 2 - Blocks P
        do board.addCar(2, 1, 2, true, false, 1); // (2,1), (2,2)
        
        // Car 2 (V): (4,2) Length 2 - Blocks end of path
        do board.addCar(4, 2, 2, true, false, 2); // (4,2), (4,3)
        
        // Car 3 (H): (2,4) Length 3 - Underneath
        do board.addCar(2, 4, 3, false, false, 3); // (2,4), (3,4), (4,4)
        
        // Car 4 (H): (0,0) Length 2 - Top corner
        do board.addCar(0, 0, 2, false, false, 4); // (0,0), (1,0)
        
        // Car 5 (V): (5,0) Length 2
        do board.addCar(5, 0, 2, true, false, 5); // (5,0), (5,1)
        return;
    }

    /** Level 4: "Mini Jam" */
    function void level4(Board board) {
        // Player (0): (1,2) Length 2 - Starts further in
        do board.addCar(1, 2, 2, false, true, 0); // (1,2), (2,2)
        
        // Car 1 (V): (3,0) Length 3 - Blocks P
        do board.addCar(3, 0, 3, true, false, 1); // (3,0), (3,1), (3,2)
        
        // Car 2 (H): (0,4) Length 2
        do board.addCar(0, 4, 2, false, false, 2); // (0,4), (1,4)
        
        // Car 3 (V): (5,1) Length 2
        do board.addCar(5, 1, 2, true, false, 3); // (5,1), (5,2)
        
        // Car 4 (H): (3,3) Length 2 - Below the big blocker
        do board.addCar(3, 3, 2, false, false, 4); // (3,3), (4,3)
        
        // Car 5 (H): (0,0) Length 2
        do board.addCar(0, 0, 2, false, false, 5); // (0,0), (1,0)
        return;
    }
}
