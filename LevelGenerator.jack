class LevelGenerator {
    
    /** Generates a level based on the seed. */
    function void generate(Board board, int seed) {
        var int layout;
        // Modulo 5 for 5 levels
        let layout = seed - ((seed / 5) * 5); // seed % 5
        
        if (layout = 0) { do LevelGenerator.level1(board); }
        if (layout = 1) { do LevelGenerator.level2(board); }
        if (layout = 2) { do LevelGenerator.level3(board); }
        if (layout = 3) { do LevelGenerator.level4(board); }
        if (layout = 4) { do LevelGenerator.level5(board); }
        return;
    }

    /** Level 1: "The Gate" (Easy) */
    function void level1(Board board) {
        // Player (0): (0,2) Length 2
        do board.addCar(0, 2, 2, false, true, 0);
        // Car 1 (V): (2,1) Blocks (2,2) Length 2
        do board.addCar(2, 1, 2, true, false, 1);
        // Car 2 (H): (3,3) Supports Car 1 Length 2
        do board.addCar(3, 3, 2, false, false, 2);
        // Car 3 (V): (0,0) Length 2
        do board.addCar(0, 0, 2, true, false, 3);
        // Car 4 (H): (0,5) -> Length 3 (occupies 0,5 to 2,5)
        do board.addCar(0, 5, 3, false, false, 4);
        // Car 5 (V): (5,0) -> Length 3 (occupies 5,0 to 5,2)
        do board.addCar(5, 0, 3, true, false, 5);
        return;
    }

    /** Level 2: "The Double Lock" */
    function void level2(Board board) {
        // Player (0): (0,2) Length 2
        do board.addCar(0, 2, 2, false, true, 0);
        // Car 1 (V): (2,1) -> Length 3 (occupies 2,1 to 2,3)
        do board.addCar(2, 1, 3, true, false, 1);
        // Car 2 (V): (3,2) Length 2
        do board.addCar(3, 2, 2, true, false, 2);
        // Car 3 (H): (0,0) Length 2
        do board.addCar(0, 0, 2, false, false, 3);
        // Car 4 (H): (4,4) Length 2
        do board.addCar(4, 4, 2, false, false, 4);
        // Car 5 (H): (0,4) -> Length 3 (occupies 0,4 to 2,4)
        do board.addCar(0, 4, 3, false, false, 5);
        return;
    }

    /** Level 3: "The Shuffle" */
    function void level3(Board board) {
        // Player (0): (0,2) Length 2
        do board.addCar(0, 2, 2, false, true, 0);
        // Car 1 (V): (2,1) Length 2
        do board.addCar(2, 1, 2, true, false, 1);
        // Car 2 (H): (0,3) Blocks Car 1 Length 2 (Fixed from 2,3 to avoid collision with Car 3)
        do board.addCar(0, 3, 2, false, false, 2);
        // Car 3 (V): (3,2) -> Length 3 (occupies 3,2 to 3,4)
        do board.addCar(3, 2, 3, true, false, 3);
        // Car 4 (H): (0,0) Length 2
        do board.addCar(0, 0, 2, false, false, 4);
        // Car 5 (V): (5,3) -> Length 3 (occupies 5,3 to 5,5)
        do board.addCar(5, 3, 3, true, false, 5);
        return;
    }

    /** Level 4: "Traffic Jam" */
    function void level4(Board board) {
        // Player (0): (1,2) Length 2
        do board.addCar(1, 2, 2, false, true, 0);
        // Car 1 (V): (3,1) Length 2
        do board.addCar(3, 1, 2, true, false, 1);
        // Car 2 (H): (3,3) -> Length 3 (occupies 3,3 to 5,3)
        do board.addCar(3, 3, 3, false, false, 2);
        // Car 3 (V): (0,1) Length 2
        do board.addCar(0, 1, 2, true, false, 3);
        // Car 4 (H): (0,4) Length 2
        do board.addCar(0, 4, 2, false, false, 4);
        // Car 5 (V): (5,0) -> Length 3 (occupies 5,0 to 5,2) (Fixed from 5,2 to avoid collision with Car 2)
        do board.addCar(5, 0, 3, true, false, 5);
        return;
    }

    /** Level 5: "The Maze" */
    function void level5(Board board) {
        // Player (0): (0,2) Length 2
        do board.addCar(0, 2, 2, false, true, 0);
        // Car 1 (V): (2,1) Length 2
        do board.addCar(2, 1, 2, true, false, 1);
        // Car 2 (V): (3,2) -> Length 3 (occupies 3,2 to 3,4)
        do board.addCar(3, 2, 3, true, false, 2);
        // Car 3 (H): (0,4) -> Length 3 (occupies 0,4 to 2,4) (Fixed from 1,4 to avoid collision with Car 2)
        do board.addCar(0, 4, 3, false, false, 3);
        // Car 4 (V): (0,3) Length 2
        do board.addCar(0, 3, 2, true, false, 4);
        // Car 5 (H): (4,0) Length 2
        do board.addCar(4, 0, 2, false, false, 5);
        return;
    }
}
